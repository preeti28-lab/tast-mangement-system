PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/task_management
CLIENT_URL=http://localhost:3000
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Optional: email notifications (leave empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NexTask <no-reply@example.com>"
